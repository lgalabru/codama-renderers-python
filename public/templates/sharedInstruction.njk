{% extends "layout.njk" %}
{% block main %}

import typing
from dataclasses import dataclass, field

from .pubkey import Pubkey

__all__ = [
    "AccountMeta",
    "Instruction",
]


@dataclass(frozen=True)
class AccountMeta:
    """An account required by an instruction."""

    pubkey: Pubkey
    is_signer: bool = False
    is_writable: bool = False


@dataclass(frozen=True)
class Instruction:
    """A built program instruction, ready to be added to a transaction."""

    program_id: Pubkey
    accounts: typing.List[AccountMeta] = field(default_factory=list)
    data: bytes = b""
{% endblock %}
